# Copy to apps/portal-api/.env (API) and apps/portal-web/.env (Vite picks VITE_*).

# --- Portal API (apps/portal-api/.env) ---
PORT=8792
HOST=0.0.0.0
COOKIE_SECRET=portal-dev-cookie-secret-change-me
CORS_ORIGINS=http://localhost:5176
TRUSTID_MODE=mock
TRUSTID_API=http://localhost:8787
TRUSTID_CLIENT_ID=lifeos_portal_public
INSTALL_MODE=local
MASTER_DISTRIBUTOR_URL=http://localhost:3100
HOSPITALITYOS_API=http://localhost:8800
ECOMMERCEOS_API_URL=http://localhost:8900
INTERNAL_PROVISION_TOKEN=dev-primitives-token
HOS_STAFF_LAUNCH_URL=https://{subdomain}.lifeos.app/staff
HOS_GUEST_LAUNCH_URL=https://{subdomain}.lifeos.app/guest
GATEWAY_MODE=local
DATAZONE_API_URL=http://localhost:4200
FINPROVE_API_URL=http://localhost:4220
FINPROVE_BOUND=true
