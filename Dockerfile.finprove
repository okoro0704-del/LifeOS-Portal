# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/portal-api/package.json apps/portal-api/
COPY apps/finprove/package.json apps/finprove/
COPY apps/portal-web/package.json apps/portal-web/
COPY apps/lifeos-business-portal/package.json apps/lifeos-business-portal/
COPY apps/lifeos-platform-admin/package.json apps/lifeos-platform-admin/
COPY packages/shared/package.json packages/shared/
COPY packages/env/package.json packages/env/
COPY packages/finprove/package.json packages/finprove/
RUN npm ci

COPY . .
RUN npm run build -w @lifeos-portal/shared \
  && npm run build -w @lifeos-portal/finprove \
  && npm run build -w @lifeos-portal/finprove-engine \
  && npm prune --omit=dev

FROM node:22-alpine AS production
WORKDIR /app
ENV NODE_ENV=production \
    HOST=:: \
    PORT=4220 \
    NODE_OPTIONS=--conditions=production
RUN apk add --no-cache curl

COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/finprove/package.json ./apps/finprove/
COPY --from=build /app/apps/finprove/dist ./apps/finprove/dist
COPY --from=build /app/packages/finprove/package.json ./packages/finprove/
COPY --from=build /app/packages/finprove/dist ./packages/finprove/dist

WORKDIR /app/apps/finprove
EXPOSE 4220
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:${PORT}/health || exit 1
CMD ["node", "dist/index.js"]
