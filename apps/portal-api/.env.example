PORT=8792
HOST=0.0.0.0
COOKIE_SECRET=portal-dev-cookie-secret-change-me
CORS_ORIGINS=http://localhost:5176
ENABLE_TRUST_ID=false
BYPASS_TRUST_ID=true
BYPASS_AUTH_FOR_TESTING=true
DEFAULT_USER_ROLE=ADMIN
ELFCOM_API_URL=https://elfcomnode-production.up.railway.app
ELFCOM_BAAS_API_KEY=
LOCAL_ADMIN_EMAIL=admin@lifeos.local
LOCAL_ADMIN_PASSWORD=
TRUSTID_MODE=mock
TRUSTID_API=http://localhost:8787
TRUSTID_CLIENT_ID=lifeos_portal_public
INSTALL_MODE=local
MASTER_DISTRIBUTOR_URL=http://localhost:3100
HOSPITALITYOS_API=http://localhost:8800
ECOMMERCEOS_API_URL=http://localhost:8900
INTERNAL_PROVISION_TOKEN=dev-primitives-token
HOS_STAFF_LAUNCH_URL=https://{subdomain}.getlifeos.app/admin
HOS_GUEST_LAUNCH_URL=https://{subdomain}.getlifeos.app/
ECO_STOREFRONT_LAUNCH_URL=https://{subdomain}.lifeos.app
ECO_ADMIN_LAUNCH_URL=https://{subdomain}.lifeos.app/admin
GATEWAY_MODE=local
DATAZONE_API_URL=http://localhost:4200
FINPROVE_API_URL=http://localhost:4220
FINPROVE_BOUND=true
DATAZONE_BOUND=true
# Attaches {subdomain}.getlifeos.app on the Netlify guest site after install.
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=6fe10d54-6f94-4326-8933-ec5a383ec188
# NETLIFY_DNS_ZONE_ID=6a9b2bad0fa61322d229a883
# Optional in development. Required when NODE_ENV=production.
# Portal-owned schema `portal` — do not share Data Zone media tables.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/lifeos

# Production (Render / Vercel API service) — no localhost, no mock Trust ID
# NODE_ENV=production
# GATEWAY_MODE=production
# PORTAL_SECRET_KEY=replace-with-32-plus-character-secret
# COOKIE_SECRET=same-as-PORTAL_SECRET_KEY
# TRUSTID_MODE=remote
# TRUST_ID_API_URL=https://trust.getlifeos.app
# DATAZONE_API_URL=https://datazone.getlifeos.app
# FINPROVE_API_URL=https://finprove.getlifeos.app
# PORTAL_DOMAIN=https://getlifeos.app
# PLATFORM_ADMIN_URL=https://admin.getlifeos.app
# CORS_ORIGINS=https://getlifeos.app,https://www.getlifeos.app,https://admin.getlifeos.app,https://business.getlifeos.app
# INTERNAL_PROVISION_TOKEN=replace-me
# DATABASE_URL=postgres://portal:portal@db.internal:5432/lifeos
# VITE_PORTAL_API=https://api.getlifeos.app
# VITE_GATEWAY_URL=https://api.getlifeos.app
# VITE_TRUSTID_MODE=remote
