PORT=8792
HOST=0.0.0.0
COOKIE_SECRET=portal-dev-cookie-secret-change-me
CORS_ORIGINS=http://localhost:5176
ENABLE_TRUST_ID=false
# TRUSTID_AUTH_MODE=disabled|canary|required (wins over ENABLE_TRUST_ID; unset = disabled).
#   canary: TrustID sign-in AND local sign-in (verification/account linking; not a permanent state).
#   required: TrustID only; local sign-in/register off. Legacy ENABLE_TRUST_ID=true means required.
# Production TrustID API (the issuer): https://trustedid.netlify.app/api
# PLATFORM_ADMIN_TRUST_IDS= (Portal-side admin grants by TrustID; empty by default in production)
# Local/test only: NODE_ENV=production refuses to boot with either bypass set to true.
BYPASS_TRUST_ID=true
BYPASS_AUTH_FOR_TESTING=true
DEFAULT_USER_ROLE=ADMIN
ELFCOM_API_URL=https://elfcomnode-production.up.railway.app
ELFCOM_BAAS_API_KEY=
# Owner account. Production: both or neither, password 16+ chars; never a substitute for TrustID step-up.
LOCAL_ADMIN_EMAIL=admin@lifeos.local
LOCAL_ADMIN_PASSWORD=
TRUSTID_MODE=mock
TRUSTID_API=http://localhost:8787
TRUSTID_CLIENT_ID=lifeos_portal_public
INSTALL_MODE=local
MASTER_DISTRIBUTOR_URL=http://localhost:3100
HOSPITALITYOS_API=http://localhost:8800
ECOMMERCEOS_API_URL=http://localhost:8900
INTERNAL_PROVISION_TOKEN=dev-primitives-token
HOS_STAFF_LAUNCH_URL=https://{subdomain}.getlifeos.app/admin
HOS_GUEST_LAUNCH_URL=https://{subdomain}.getlifeos.app/
ECO_STOREFRONT_LAUNCH_URL=https://{subdomain}.getlifeos.app
ECO_ADMIN_LAUNCH_URL=https://{subdomain}.getlifeos.app/admin
GATEWAY_MODE=local
DATAZONE_API_URL=http://localhost:4200
FINPROVE_API_URL=http://localhost:4220
FINPROVE_BOUND=true
DATAZONE_BOUND=true
# Attaches {subdomain}.getlifeos.app on the Netlify guest site after install.
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=6fe10d54-6f94-4326-8933-ec5a383ec188
# NETLIFY_DNS_ZONE_ID=6a9b2bad0fa61322d229a883
# Domain Infrastructure (server secrets only — never VITE_*/NEXT_PUBLIC_*).
# Missing values disable the domain capability only; the rest of Portal keeps working.
# DOMAIN_PROVIDER=namecheap
# NAMECHEAP_ENV=sandbox
# NAMECHEAP_API_USER=
# NAMECHEAP_USERNAME=
# NAMECHEAP_API_KEY=
# NAMECHEAP_CLIENT_IP=
# Production registrations stay off until this is exactly "true".
# DOMAIN_PURCHASES_ENABLED=false
# STATIC only when the host guarantees a fixed outbound IPv4 (e.g. Railway Static Outbound IPs).
# DOMAIN_PROVIDER_EGRESS_IP_STATUS=UNKNOWN
# Comma-separated IPv4s the host may use for outbound registrar traffic. Production registrar
# writes require exactly one, equal to NAMECHEAP_CLIENT_IP and to a fresh egress observation.
# DOMAIN_PROVIDER_EGRESS_IPS=
# NAMECHEAP_TIMEOUT_MS=30000
# NAMECHEAP_REGISTER_TIMEOUT_MS=90000
# Custom-domain hosting reuses NETLIFY_AUTH_TOKEN + NETLIFY_SITE_ID above.
# DOMAIN_HOSTING_NETLIFY_TARGET=lifeos-portal1.netlify.app
# DOMAIN_HOSTING_APEX_IPV4=75.2.60.5
# Optional in development. Required when NODE_ENV=production.
# Portal-owned schema `portal` — do not share Data Zone media tables.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/lifeos

# Session security
# TRUSTID_TOKEN_KEYS seals the TrustID bearer a Portal session keeps for downstream calls
# (AES-256-GCM). Dedicated key material, never the cookie secret. Format: kid:base64(32 bytes),...
# First key seals, all keys open. Rotate: prepend a new key, drop the old one after SESSION_TTL_HOURS.
# Required in production when ENABLE_TRUST_ID=true. Generate with: npm run secrets
# TRUSTID_TOKEN_KEYS=k2026a:REPLACE_WITH_BASE64_32_BYTES
# Cookie-only browser surfaces (HttpOnly session, no token in JS). Production default: admin + business.
# COOKIE_SESSION_ORIGINS=https://admin.getlifeos.app,https://business.getlifeos.app
# SESSION_TTL_HOURS=24
# Housekeeping sweep of expired session rows (expiry is enforced on every request regardless).
# SESSION_SWEEP_MINUTES=15

# Production (Render / Vercel API service) — no localhost, no mock Trust ID
# NODE_ENV=production
# GATEWAY_MODE=production
# PORTAL_SECRET_KEY=replace-with-32-plus-character-secret
# COOKIE_SECRET=same-as-PORTAL_SECRET_KEY
# TRUSTID_MODE=remote
# TRUST_ID_API_URL=https://trust.getlifeos.app
# DATAZONE_API_URL=https://datazone.getlifeos.app
# FINPROVE_API_URL=https://finprove.getlifeos.app
# PORTAL_DOMAIN=https://getlifeos.app
# PLATFORM_ADMIN_URL=https://admin.getlifeos.app
# CORS_ORIGINS=https://getlifeos.app,https://www.getlifeos.app,https://admin.getlifeos.app,https://business.getlifeos.app
# INTERNAL_PROVISION_TOKEN=replace-me
# DATABASE_URL=postgres://portal:portal@db.internal:5432/lifeos
# Verified TLS to Railway Postgres: the database's public root CA (PEM, 
-escaped PEM, or base64 PEM).
# Railway's image issues its server certificate from a per-instance root CA (data/certs/root.crt, SAN
# postgres.railway.internal), so no public bundle verifies it. Set => verify-full; unset => encrypted, unverified.
# DATABASE_CA_CERT=
# VITE_PORTAL_API=https://api.getlifeos.app
# VITE_GATEWAY_URL=https://api.getlifeos.app
# VITE_TRUSTID_MODE=remote
